<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows SDK projection: StartupTask / package APIs for the MSIX (Store) build. Still runs on Windows 10 1809+. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Explicit usings only: WPF + WinForms implicit usings clash (Application, MessageBox, Clipboard…). -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <AssemblyName>ClipboardManager</AssemblyName>
    <RootNamespace>ClipboardManager.App</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\packaging\Assets\app.ico</ApplicationIcon>
    <Version>0.3.3</Version>
    <Product>Advanced Clipboard Manager</Product>
    <Authors>duytiena2</Authors>
    <Company>duytiena2</Company>
    <EnableCompressionInSingleFile Condition="'$(PublishSingleFile)' == 'true'">true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClipboardManager.Core\ClipboardManager.Core.csproj" />
  </ItemGroup>

  <!-- Official SQLite build (with FTS5). build.ps1 downloads it into lib\; falls back to Windows' winsqlite3.dll if absent. -->
  <ItemGroup Condition="Exists('..\..\lib\sqlite3.dll')">
    <None Include="..\..\lib\sqlite3.dll" CopyToOutputDirectory="PreserveNewest" Link="sqlite3.dll" />
  </ItemGroup>

</Project>
