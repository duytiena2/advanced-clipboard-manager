<Window x:Class="ClipboardManager.App.UI.QuickPasteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Paste"
        Width="760" Height="520"
        MinWidth="280" MinHeight="220"
        WindowStyle="None" ResizeMode="CanResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="True"
        WindowStartupLocation="Manual"
        Background="Transparent" BorderThickness="0"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="#15171C"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#0E6B68" />
        <SolidColorBrush x:Key="Line" Color="#E5E7EB" />
        <SolidColorBrush x:Key="Muted" Color="#5A6170" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="ItemStyle" TargetType="ListBoxItem">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="2,1,2,1" />
            <Setter Property="Foreground" Value="#15171C" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <!-- Fluent focus indicator pill on left edge -->
                                <Border x:Name="FocusBar" Width="3" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        CornerRadius="1.5" Background="{StaticResource Accent}" Visibility="Collapsed" Margin="-6,0,0,0" />
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EBF5F4" />
                                <Setter TargetName="FocusBar" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MetaLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="MetaValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="Kbd" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="Margin" Value="6,0,14,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Keycap" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1,1,1,2" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        <Style x:Key="KeycapText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Segoe UI" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#334155" />
        </Style>

        <Style x:Key="OnboardingKeycap" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="1,1,1,2" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        <Style x:Key="OnboardingKeycapText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Keyboard shortcuts help dialog styles -->
        <Style x:Key="ShortcutCard" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="ShortcutRow" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF2F6" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModalKeycap" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1,1,1,2" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        <Style x:Key="ModalKeycapText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="KeycapPlus" TargetType="TextBlock">
            <Setter Property="Text" Value="+" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="1,0" />
        </Style>
        <Style x:Key="SyntaxChip" TargetType="Border">
            <Setter Property="Background" Value="#F0FDFA" />
            <Setter Property="BorderBrush" Value="#CCFBF1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SyntaxChipText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#0F766E" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="HintLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#5A6170" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Background" Value="#12000000" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22000000" />
                                <Setter Property="Foreground" Value="#111827" />
                            </Trigger>
                            <Trigger Property="Tag" Value="active">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="active" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#128380" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Background" Value="#08000000" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#12000000" />
            <Setter Property="Foreground" Value="#2D3139" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,5,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#12000000" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#20000000" />
                                <Setter Property="Foreground" Value="#15171C" />
                            </Trigger>
                            <Trigger Property="Tag" Value="active">
                                <Setter TargetName="Bd" Property="Background" Value="#140E6B68" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#400E6B68" />
                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderActionButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="6,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0E000000" />
                                <Setter Property="Foreground" Value="#15171C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slim overlay-style scrollbar: no arrows, rounded thumb that darkens on hover/drag -->
        <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd" Background="#55808080" CornerRadius="3" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#80808080" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#A0808080" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Margin" Value="0,4,3,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" MinHeight="24" />
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="6" />
                    <Setter Property="MinHeight" Value="6" />
                    <Setter Property="Margin" Value="4,0,4,3" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}" MinWidth="24" />
                                    </Track.Thumb>
                                </Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Main Window Container with modern Windows 11 Fluent style -->
    <Border x:Name="RootBorder" CornerRadius="0" BorderThickness="1" BorderBrush="{StaticResource Line}"
            Background="#FFFFFF" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" /> <!-- Header: Search and buttons (Row 0) -->
                <RowDefinition Height="Auto" /> <!-- Filter chips & Paste Stack banner (Row 1) -->
                <RowDefinition Height="*" />  <!-- List + Preview (Row 2) -->
                <RowDefinition Height="34" /> <!-- Footer (Row 3) -->
            </Grid.RowDefinitions>

            <!-- Row 0: Search and Header Controls -->
            <Border x:Name="Header" Grid.Row="0" Background="Transparent" BorderBrush="{StaticResource Line}"
                    BorderThickness="0,0,0,1" ToolTip="Drag to move">
                <DockPanel Margin="14,0,14,0">
                    <Button x:Name="CloseButton" DockPanel.Dock="Right" Width="28" Height="28" Margin="3,0,0,0"
                            Focusable="False" Cursor="Hand" ToolTip="Close (Esc)"
                            AutomationProperties.Name="Close Quick Paste">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                    <TextBlock x:Name="CloseGlyph" Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10.5"
                                               Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#C42B1C" />
                                        <Setter TargetName="CloseGlyph" Property="Foreground" Value="#FFFFFF" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#A82315" />
                                        <Setter TargetName="CloseGlyph" Property="Foreground" Value="#FFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <ToggleButton x:Name="KeepOpenButton" DockPanel.Dock="Right" Width="28" Height="28" Margin="3,0,0,0"
                                  Focusable="False" Cursor="Hand" ToolTip="Pin window (Ctrl+T)"
                                  AutomationProperties.Name="Keep Quick Paste open">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                    <TextBlock x:Name="Glyph" Text="&#xE718;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12.5"
                                               Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#10000000" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#180E6B68" />
                                        <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Accent}" />
                                        <Setter TargetName="Glyph" Property="Text" Value="&#xE840;" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>


                    <Button x:Name="SettingsButton" DockPanel.Dock="Right" Width="28" Height="28" Margin="3,0,0,0"
                            Focusable="False" Cursor="Hand" ToolTip="Settings (Ctrl+,)"
                            AutomationProperties.Name="Open settings">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                    <TextBlock x:Name="SettingsGlyph" Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12.5"
                                               Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#10000000" />
                                        <Setter TargetName="SettingsGlyph" Property="Foreground" Value="#15171C" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="HelpButton" DockPanel.Dock="Right" Width="28" Height="28" Margin="3,0,6,0"
                            Focusable="False" Cursor="Hand" ToolTip="Shortcuts (F1)"
                            AutomationProperties.Name="Show keyboard shortcuts">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                    <TextBlock x:Name="HelpGlyph" Text="&#xE897;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12.5"
                                               Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#10000000" />
                                        <Setter TargetName="HelpGlyph" Property="Foreground" Value="#15171C" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>



                    <TextBlock x:Name="CountText" DockPanel.Dock="Right" Foreground="#8A909C" FontSize="11.5"
                               VerticalAlignment="Center" Margin="0,0,8,0" />

                    <!-- Search box with inline Filter Chips -->
                    <Border x:Name="SearchContainer" CornerRadius="8" Background="#F3F4F6" BorderBrush="{StaticResource Line}" BorderThickness="1"
                            Height="34" Margin="0,0,8,0" Padding="10,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="13" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="Placeholder" Text="Search clipboard…"
                                           Foreground="#8A909C" FontSize="13.5" VerticalAlignment="Center" IsHitTestVisible="False" />
                                <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent" FontSize="13.5"
                                         VerticalAlignment="Center" VerticalContentAlignment="Center" Padding="0"
                                         AutomationProperties.Name="Search clipboard" />
                            </Grid>
                            <Button x:Name="ClearSearchButton" Grid.Column="2" Width="18" Height="18" Margin="4,0,4,0"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Focusable="False"
                                    VerticalAlignment="Center" Visibility="Collapsed" ToolTip="Clear search text"
                                    AutomationProperties.Name="Clear search text">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="#14000000" CornerRadius="9" Width="18" Height="18">
                                            <TextBlock Text="✕" FontSize="8.5" FontWeight="Bold"
                                                       Foreground="#5A6170" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#25000000" />
                                                <Setter Property="Foreground" Value="#15171C" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <!-- Filter Chips: [SQL x] [Pinned x] [Dev x] -->
                            <ScrollViewer Grid.Column="3" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                          Focusable="False" VerticalAlignment="Center">
                                <ItemsControl x:Name="FilterChipsItemsControl" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#200E6B68" BorderBrush="#350E6B68" BorderThickness="1"
                                                    CornerRadius="10" Margin="3,0,0,0" Padding="7,2,4,2" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                                    <Button Click="OnRemoveFilterChipClick" Tag="{Binding}"
                                                            Width="14" Height="14" Margin="3,0,0,0"
                                                            Background="Transparent" BorderThickness="0"
                                                            Cursor="Hand" Focusable="False" VerticalAlignment="Center"
                                                            ToolTip="Remove filter (Backspace)">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Width="14" Height="14">
                                                                    <TextBlock Text="✕" FontSize="8" FontWeight="Bold"
                                                                               Foreground="{StaticResource Accent}"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="#350E6B68" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>

            <!-- Search Suggestions Dropdown (Recent searches & Filter discovery) -->
            <Popup x:Name="SearchSuggestionsPopup"
                   PlacementTarget="{Binding ElementName=SearchContainer}"
                   Placement="Bottom"
                   AllowsTransparency="True"
                   StaysOpen="True"
                   PopupAnimation="Fade"
                   VerticalOffset="4">
                <Border x:Name="SuggestionsCard"
                        Width="{Binding ElementName=SearchContainer, Path=ActualWidth}"
                        MinWidth="340" MaxHeight="380"
                        Background="#FFFFFF"
                        BorderBrush="{StaticResource Line}" BorderThickness="1"
                        CornerRadius="10" Padding="0,6"
                        UseLayoutRounding="True" SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.15" />
                    </Border.Effect>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- RECENT SEARCHES -->
                            <Border x:Name="RecentSearchesSection" Visibility="Collapsed" Margin="0,0,0,4">
                                <StackPanel>
                                    <DockPanel Margin="14,4,14,4">
                                        <TextBlock Text="RECENT SEARCHES" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#8A909C" DockPanel.Dock="Left" />
                                        <Button x:Name="ClearAllRecentButton" Content="Clear" DockPanel.Dock="Right"
                                                Foreground="#8A909C" FontSize="10.5" Background="Transparent"
                                                BorderThickness="0" Cursor="Hand" Focusable="False"
                                                Click="OnClearAllRecentClick" />
                                    </DockPanel>
                                    <ItemsControl x:Name="RecentSearchesList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="Transparent" Padding="14,5" Cursor="Hand"
                                                        MouseLeftButtonUp="OnRecentSearchItemClick">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#0A000000" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <DockPanel LastChildFill="True">
                                                        <Button DockPanel.Dock="Right" Width="18" Height="18"
                                                                Background="Transparent" BorderThickness="0"
                                                                Cursor="Hand" Focusable="False" ToolTip="Remove from recent"
                                                                Click="OnRemoveRecentSearchClick" Tag="{Binding}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="DelBd" Background="Transparent" CornerRadius="4">
                                                                        <TextBlock Text="✕" FontSize="9" Foreground="#8A909C"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="DelBd" Property="Background" Value="#20000000" />
                                                                            <Setter Property="Foreground" Value="#15171C" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                        <TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                   FontSize="11.5" Foreground="#8A909C" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <TextBlock Text="{Binding}" FontSize="12.5" Foreground="#15171C"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Rectangle Height="1" Fill="{StaticResource Line}" Margin="12,6" />
                                </StackPanel>
                            </Border>

                            <!-- FILTERS DISCOVERY -->
                            <TextBlock Text="FILTERS" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#8A909C" Margin="14,4,14,6" />

                            <!-- Type -->
                            <Border Padding="14,4" Background="Transparent">
                                <StackPanel>
                                    <TextBlock Text="🏷️ Type" FontWeight="SemiBold" FontSize="12" Foreground="#15171C" Margin="0,0,0,4" />
                                    <WrapPanel x:Name="TypeFilterPills" Orientation="Horizontal" />
                                </StackPanel>
                            </Border>



                            <!-- Pinned -->
                            <Border Padding="14,4" Background="Transparent">
                                <StackPanel>
                                    <TextBlock Text="📌 Pinned" FontWeight="SemiBold" FontSize="12" Foreground="#15171C" Margin="0,0,0,4" />
                                    <WrapPanel x:Name="PinnedFilterPills" Orientation="Horizontal" />
                                </StackPanel>
                            </Border>

                            <!-- Date -->
                            <Border Padding="14,4" Background="Transparent">
                                <StackPanel>
                                    <TextBlock Text="📅 Date" FontWeight="SemiBold" FontSize="12" Foreground="#15171C" Margin="0,0,0,4" />
                                    <WrapPanel x:Name="DateFilterPills" Orientation="Horizontal" />
                                </StackPanel>
                            </Border>

                            <!-- Sensitive -->
                            <Border Padding="14,4,14,8" Background="Transparent">
                                <StackPanel>
                                    <TextBlock Text="🔒 Sensitive" FontWeight="SemiBold" FontSize="12" Foreground="#15171C" Margin="0,0,0,4" />
                                    <WrapPanel x:Name="SensitiveFilterPills" Orientation="Horizontal" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Popup>

            <!-- Row 1: Onboarding Banner, Filter chips & Paste Stack Banner -->
            <StackPanel Grid.Row="1">
                <!-- Onboarding Welcome Banner (Toast Banner) -->
                <Border x:Name="OnboardingBanner" Background="#F0FDFA" BorderBrush="{StaticResource Accent}"
                        BorderThickness="1" CornerRadius="8" Margin="14,4,14,6" Padding="12,8" Visibility="Collapsed">
                    <DockPanel LastChildFill="True">
                        <!-- Dismiss Button (Got it) -->
                        <Button x:Name="DismissOnboardingButton" DockPanel.Dock="Right" Cursor="Hand" Focusable="False"
                                Background="Transparent" BorderThickness="0" Margin="10,0,0,0" VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#140E6B68" CornerRadius="12" Padding="10,4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#250E6B68" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="DismissLabelText" Text="Got it" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock Text="✕" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Content with Keycaps -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Quick Tip Badge -->
                            <Border Background="{StaticResource Accent}" CornerRadius="4" Padding="7,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE789;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                               Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock x:Name="OnboardingBadgeText" Text="TIP" FontSize="10.5" FontWeight="Bold"
                                               Foreground="#FFFFFF" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="OnboardingPrefixText" Text="Press" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <StackPanel x:Name="OnboardingKeycapsContainer" Orientation="Horizontal" VerticalAlignment="Center" />
                            <TextBlock x:Name="OnboardingSuffixText" Text="anywhere to open clipboard history." FontSize="12.5" Foreground="#334155" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Filter Chips -->
                <Border x:Name="FilterBar" Background="Transparent" Padding="14,2,14,4">
                    <DockPanel LastChildFill="False">
                        <Button x:Name="ChipAll" Content="All" Style="{StaticResource ChipButton}" Tag="active"
                                ToolTip="All items" />
                        <Button x:Name="ChipCode" Content="💻 Code" Style="{StaticResource ChipButton}"
                                ToolTip="Filter code (type:code)" />
                        <Button x:Name="ChipImage" Content="🗃️ Images" Style="{StaticResource ChipButton}"
                                ToolTip="Filter images (type:image)" />
                        <Button x:Name="ChipPinned" Content="📌 Pinned" Style="{StaticResource ChipButton}"
                                ToolTip="Filter pinned (pinned:true)" />
                        <Button x:Name="ChipSnippet" Content="🏷️ Snippets" Style="{StaticResource ChipButton}"
                                ToolTip="Filter snippets (type:snippet)" />
                    </DockPanel>
                </Border>

                <!-- Dedicated Paste Stack Banner (Item 8) -->
                <Border x:Name="PasteStackBanner" Background="#180E6B68" BorderBrush="#300E6B68"
                        BorderThickness="0,1,0,1" Padding="14,6" Visibility="Collapsed">
                    <DockPanel LastChildFill="True">
                        <Button x:Name="StopPasteStackButton" DockPanel.Dock="Right" Content="Stop Stack"
                                Padding="8,2" FontSize="11" Margin="8,0,0,0" Focusable="False" Cursor="Hand"
                                Style="{StaticResource HeaderActionButton}" ToolTip="Stop paste stack (Esc)" />
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="📚 Paste Stack" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Border Background="#250E6B68" CornerRadius="4" Padding="5,1">
                                <TextBlock x:Name="PasteStackStepText" Text="1 / 5" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Accent}" />
                            </Border>
                        </StackPanel>
                        <ProgressBar x:Name="PasteStackProgressBar" DockPanel.Dock="Right" Width="80" Height="6"
                                     Margin="10,0" Minimum="0" Maximum="100" VerticalAlignment="Center" Foreground="{StaticResource Accent}" />
                        <TextBlock x:Name="PasteStackNextTitle" Text="Next: item" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="#15171C" />
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- Row 2: List + preview -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ListColumn" Width="300" MinWidth="0" />
                    <ColumnDefinition x:Name="SplitColumn" Width="5" MinWidth="0" />
                    <ColumnDefinition x:Name="PreviewColumn" Width="*" MinWidth="0" />
                </Grid.ColumnDefinitions>

                <ListBox x:Name="ItemsList" Grid.Column="0" BorderThickness="0" Background="Transparent" Padding="6,4"
                         ItemContainerStyle="{StaticResource ItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         VirtualizingPanel.CacheLength="2"
                         VirtualizingPanel.CacheLengthUnit="Page"
                         AutomationProperties.Name="Clipboard items">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Row 0: Shortcut + Title + Type Badge -->
                                <DockPanel Grid.Row="0" LastChildFill="True">
                                    <!-- Shortcut (1..9 for Ctrl+1..9) -->
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Shortcut}" Width="14" FontSize="11" Opacity="0.45"
                                               FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center" Margin="0,0,6,0"
                                               ToolTip="Ctrl + number to quick paste" />

                                    <!-- Multi-select / paste stack checkbox if active -->
                                    <Border DockPanel.Dock="Left" x:Name="CheckboxContainer" Margin="0,0,4,0" VerticalAlignment="Center"
                                            Visibility="{Binding MultiSelectActive, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="SelectGlyphText" Text="{Binding SelectGlyph}"
                                                       FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource Accent}"
                                                       ToolTip="Select item (Ctrl+Space)" />
                                            <TextBlock x:Name="MarkOrderLabel" Text="{Binding MarkOrderText}" FontSize="9.5" FontWeight="Bold" Margin="1,0,0,0"
                                                       VerticalAlignment="Center" Foreground="{StaticResource Accent}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Type Badge on trailing edge -->
                                    <Border DockPanel.Dock="Right" x:Name="TypeBadgeBorder"
                                            CornerRadius="4" Padding="5,1" Margin="6,0,0,0"
                                            Background="#08000000" VerticalAlignment="Center">
                                        <TextBlock x:Name="TypeBadgeText" Text="{Binding TypeBadge}"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="#5A6170" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Primary Content (Title) -->
                                    <TextBlock x:Name="ItemTitleText" Text="{Binding Title}"
                                               FontFamily="{Binding TitleFont}" FontSize="12.5" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               Foreground="#15171C" />
                                </DockPanel>

                                <!-- Row 1: TimeAgo + CopyCount + Pin + Sensitive + Expiry -->
                                <DockPanel Grid.Row="1" Margin="20,2,0,0" LastChildFill="False">
                                    <!-- Relative time -->
                                    <TextBlock DockPanel.Dock="Left" x:Name="ItemTimeAgoText" Text="{Binding TimeAgo}"
                                               FontSize="10.5" Foreground="#8A909C"
                                               VerticalAlignment="Center" />

                                    <!-- Pinned indicator -->
                                    <TextBlock DockPanel.Dock="Right" x:Name="PinIndicator" Text="&#xE840;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="10" Foreground="{StaticResource Accent}"
                                               Margin="6,0,0,0" VerticalAlignment="Center"
                                               ToolTip="Pinned (Ctrl+P)"
                                               Visibility="{Binding HasPin, Converter={StaticResource BoolToVis}}" />

                                    <!-- Sensitive indicator -->
                                    <Border DockPanel.Dock="Right" x:Name="SensitiveIndicator"
                                            Background="#18D97706" CornerRadius="3" Padding="4,0" Margin="6,0,0,0"
                                            VerticalAlignment="Center" ToolTip="Sensitive data (Ctrl+R to reveal)"
                                            Visibility="{Binding HasSensitiveBadge, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9.5" Foreground="#D97706" Margin="0,0,2,0" />
                                            <TextBlock Text="Sensitive" FontSize="9.5" FontWeight="SemiBold" Foreground="#D97706" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Expiration indicator (chỉ hiện khi sắp hết hạn) -->
                                    <Border DockPanel.Dock="Right" x:Name="ExpiryIndicator"
                                            Background="#18D97706" CornerRadius="3" Padding="4,0" Margin="6,0,0,0"
                                            VerticalAlignment="Center" ToolTip="{Binding ExpirationTooltip}"
                                            Visibility="{Binding HasExpiration, Converter={StaticResource BoolToVis}}">
                                        <TextBlock x:Name="ExpiryText" Text="{Binding ExpirationBadgeText}"
                                                   FontSize="9.5" FontWeight="SemiBold" Foreground="#D97706"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </DockPanel>
                            </Grid>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                    <Setter TargetName="ItemTitleText" Property="Foreground" Value="{StaticResource Accent}" />
                                    <Setter TargetName="ItemTitleText" Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <GridSplitter x:Name="PreviewSplit" Grid.Column="1"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                              ShowsPreview="False" Cursor="SizeWE" Background="Transparent" Focusable="False"
                              ToolTip="Drag to resize List / Preview • Double click: reset • Right click: menu">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Border Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Border x:Name="SplitLine" Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{StaticResource Line}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="SplitLine" Property="Background" Value="{StaticResource Accent}" />
                                    <Setter TargetName="SplitLine" Property="Width" Value="3" />
                                    <Setter TargetName="SplitLine" Property="CornerRadius" Value="1.5" />
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="SplitLine" Property="Background" Value="{StaticResource Accent}" />
                                    <Setter TargetName="SplitLine" Property="Width" Value="3" />
                                    <Setter TargetName="SplitLine" Property="CornerRadius" Value="1.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <Grid x:Name="PreviewPane" Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Content Header Bar (Badge, Stats, Actions) -->
                    <Border x:Name="PreviewHeaderBar" Grid.Row="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                            Padding="14,8" Background="#F9FAFB" Visibility="Collapsed">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="PreviewBadgeBorder" Background="#E8F2FF" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock x:Name="PreviewBadgeText" Text="SQL" FontSize="11" FontWeight="SemiBold" Foreground="#0969DA" />
                                </Border>
                                <TextBlock x:Name="PreviewStatsText" Text="SQL · 182 characters" FontSize="12" Foreground="{StaticResource Muted}"
                                           VerticalAlignment="Center" />
                                <Border x:Name="HeaderOcrBadge" Background="#E6F4F1" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="HeaderOcrBadgeText" Text="OCR Text" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                                </Border>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="FormatButton" Content="Format" Style="{StaticResource HeaderActionButton}" Margin="4,0,0,0"
                                        ToolTip="Format / Prettify code" Visibility="Collapsed" />
                                <Button x:Name="OpenUrlButton" Content="Open URL" Style="{StaticResource HeaderActionButton}" Margin="4,0,0,0"
                                        ToolTip="Open link in default browser" Visibility="Collapsed" />
                                <Button x:Name="ToggleRevealButton" Content="Reveal (Ctrl+R)" Style="{StaticResource HeaderActionButton}" Margin="4,0,0,0"
                                        ToolTip="Reveal / Hide sensitive content (Ctrl+R)" Visibility="Collapsed" />
                                <Button x:Name="CopyPreviewButton" Content="Copy" Style="{StaticResource HeaderActionButton}" Margin="4,0,0,0"
                                        ToolTip="Copy content (Ctrl+C)" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Row 1: Content Viewport Area -->
                    <Grid Grid.Row="1">
                        <!-- Empty States (Item 15) -->
                        <TextBlock x:Name="EmptyText" Visibility="Collapsed" />
                        <StackPanel x:Name="EmptyClipboardContainer" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Visibility="Collapsed">
                            <TextBlock Text="📋" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10" Opacity="0.8" />
                            <TextBlock Text="Your clipboard is empty" FontSize="15" FontWeight="SemiBold" Foreground="#15171C" HorizontalAlignment="Center" Margin="0,0,0,4" />
                            <TextBlock Text="Copy something and it will appear here." FontSize="12.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,0,0,12" />
                            <Border Style="{StaticResource Keycap}" HorizontalAlignment="Center" Padding="8,3">
                                <TextBlock Text="Ctrl+Shift+V" Style="{StaticResource KeycapText}" />
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="EmptySearchContainer" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Visibility="Collapsed">
                            <TextBlock Text="🔍" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10" Opacity="0.8" />
                            <TextBlock Text="No clipboard found" FontSize="15" FontWeight="SemiBold" Foreground="#15171C" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="Try:" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,3" />
                            <TextBlock Text="• Another keyword&#x0a;• Remove or change a filter&#x0a;• F1 for search syntax"
                                       FontSize="12" Foreground="{StaticResource Muted}" LineHeight="18" Margin="0,0,0,0" />
                        </StackPanel>

                        <!-- Sensitive Hidden State (when !Revealed) -->
                        <Border x:Name="SensitiveHiddenContainer" Background="#05000000" Margin="14" CornerRadius="8"
                                BorderBrush="#FED7AA" BorderThickness="1" Padding="20" VerticalAlignment="Center"
                                Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" MaxWidth="380">
                                <Border Background="#FEF3C7" CornerRadius="22" Width="44" Height="44" HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                                               Foreground="#D97706" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Sensitive content" FontSize="15" FontWeight="SemiBold" Foreground="#92400E"
                                           HorizontalAlignment="Center" Margin="0,0,0,3" />
                                <TextBlock x:Name="SensitiveSubtypeText" Text="API Key detected" FontSize="11.5" Foreground="#B45309"
                                           HorizontalAlignment="Center" Margin="0,0,0,12" />

                                <Border Background="#FFFFFF" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6"
                                        Padding="14,9" Margin="0,0,0,14" HorizontalAlignment="Stretch">
                                    <TextBlock x:Name="SensitiveMaskedText" Text="••••••••••••••••••••••••••••••••"
                                               FontFamily="Cascadia Mono, Consolas" FontSize="14" Foreground="#78350F"
                                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Border>

                                <Button x:Name="SensitiveRevealButton" HorizontalAlignment="Center" Cursor="Hand" Margin="0,0,0,10">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="{StaticResource Accent}" CornerRadius="6" Padding="14,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE785;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12.5"
                                                               Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <TextBlock Text="Reveal content" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF"
                                                               VerticalAlignment="Center" />
                                                    <Border Background="#25FFFFFF" CornerRadius="3" Padding="4,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="Ctrl+R" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#FFFFFF" />
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.9" /></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <TextBlock Text="Hidden to protect credentials. Auto-wipes when expired."
                                           FontSize="11" Foreground="#92400E" HorizontalAlignment="Center" TextAlignment="Center" />
                                <TextBlock x:Name="SensitiveExpiryText" Text="Auto-wipes in 5 minutes"
                                           FontSize="10.5" Foreground="#B45309" HorizontalAlignment="Center" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Image Viewer & OCR Info -->
                        <Grid x:Name="ImageContainer" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#05000000" Margin="14" CornerRadius="8" BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" ClipToBounds="True">
                                <Image x:Name="PreviewImage" Stretch="Uniform" Margin="10"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>

                            <!-- QR Code Panel: Hiển thị trực tiếp khi có mã QR / Barcode giải mã được -->
                            <Border x:Name="QrCodePanel" Grid.Row="1" Background="#FAF5FF" BorderBrush="{StaticResource Line}"
                                    BorderThickness="0,1,0,0" Padding="14,8" Visibility="Collapsed">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="#EDE9FE" CornerRadius="4" Padding="5,1" Margin="0,0,8,0">
                                                <TextBlock x:Name="QrPanelBadgeText" Text="QR CODE" FontSize="10" FontWeight="Bold" Foreground="#7C3AED" />
                                            </Border>
                                            <TextBlock Text="Decoded QR / Barcode (⇧Enter pastes):" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button x:Name="OpenQrUrlButton" Content="Open URL" Style="{StaticResource HeaderActionButton}" FontSize="11" Padding="8,2" Margin="0,0,6,0" Visibility="Collapsed" />
                                            <Button x:Name="CopyQrButton" Content="Copy QR" Style="{StaticResource HeaderActionButton}" FontSize="11" Padding="8,2" />
                                        </StackPanel>
                                    </DockPanel>
                                    <Border Background="#FFFFFF" BorderBrush="#E9D5FF" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                        <TextBox x:Name="QrTextBox" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                 MaxHeight="70" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                 FontSize="12" FontFamily="Cascadia Mono, Consolas" Foreground="#581C87" FontWeight="Medium" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- OCR Recognized Text: Hiển thị khi có text nhận diện được hoặc đang scan -->
                            <Border x:Name="OcrTextPanel" Grid.Row="2" Background="#F9FAFB" BorderBrush="{StaticResource Line}"
                                    BorderThickness="0,1,0,0" Padding="14,8" Visibility="Collapsed">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border x:Name="OcrPanelBadgeBorder" Background="#180E6B68" CornerRadius="4" Padding="5,1" Margin="0,0,8,0">
                                                <TextBlock x:Name="OcrPanelBadgeText" Text="OCR TEXT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                                            </Border>
                                            <TextBlock x:Name="OcrPanelSubtitle" Text="Recognized text in image:" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Button x:Name="CopyOcrButton" DockPanel.Dock="Right" Content="Copy Text" Style="{StaticResource HeaderActionButton}" FontSize="11" Padding="8,2" />
                                    </DockPanel>
                                    <Border Background="#FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                        <TextBox x:Name="OcrTextBox" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                 MaxHeight="90" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                 FontSize="12" FontFamily="Cascadia Mono, Consolas" Foreground="#15171C" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Hidden elements to preserve bindings / references without nulls -->
                            <TextBlock x:Name="ImageDimensionsText" Visibility="Collapsed" />
                            <Border x:Name="OcrBadgeBorder" Visibility="Collapsed"><TextBlock x:Name="OcrBadgeText" /></Border>
                            <Button x:Name="ToggleOcrButton" Visibility="Collapsed" />
                        </Grid>

                        <!-- URL Rich Card -->
                        <ScrollViewer x:Name="UrlContainer" VerticalScrollBarVisibility="Auto" Padding="16,14" Visibility="Collapsed">
                            <StackPanel>
                                <Border Background="#0816A34A" BorderBrush="#3016A34A" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                                    <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Left" Background="#1516A34A" CornerRadius="8" Width="40" Height="40" Margin="0,0,12,0">
                                            <TextBlock x:Name="UrlGlyph" Text="&#xE71B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="18" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="UrlSiteName" Text="GitHub" FontSize="15" FontWeight="SemiBold" Foreground="#15171C" />
                                            <TextBlock x:Name="UrlHostText" Text="github.com" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border Background="#05000000" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                                    <TextBox x:Name="UrlFullText" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                             TextWrapping="Wrap" FontSize="12.5" Foreground="#0969DA" FontFamily="Cascadia Mono, Consolas" />
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Button x:Name="UrlLaunchButton" Cursor="Hand" Margin="0,0,8,0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="{StaticResource Accent}" CornerRadius="6" Padding="12,5">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11.5"
                                                                   Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                        <TextBlock Text="Open in browser" FontWeight="SemiBold" FontSize="11.5" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.9" /></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button x:Name="UrlCopyButton" Content="Copy link" Style="{StaticResource HeaderActionButton}" />
                                </StackPanel>

                                <Border Background="#04000000" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="URL Breakdown" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,6" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="55" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="18" />
                                                <RowDefinition Height="18" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="Scheme" FontSize="11" Foreground="{StaticResource Muted}" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="UrlSchemeVal" FontSize="11" FontFamily="Cascadia Mono, Consolas" />
                                            <TextBlock Grid.Row="1" Text="Host" FontSize="11" Foreground="{StaticResource Muted}" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="UrlHostVal" FontSize="11" FontFamily="Cascadia Mono, Consolas" />
                                            <TextBlock Grid.Row="2" Text="Path" FontSize="11" Foreground="{StaticResource Muted}" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="UrlPathVal" FontSize="11" FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Code Viewer (Syntax Highlighting) -->
                        <Grid x:Name="CodeContainer" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Revealed secret banner -->
                            <Border x:Name="SensitiveRevealedBanner" Grid.Row="0" Background="#FEF3C7" BorderBrush="#FDE68A"
                                    BorderThickness="0,0,0,1" Padding="14,6" Visibility="Collapsed">
                                <DockPanel LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE785;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12.5"
                                                   Foreground="#D97706" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="Sensitive content revealed" FontWeight="SemiBold" FontSize="11.5"
                                                   Foreground="#92400E" VerticalAlignment="Center" />
                                        <TextBlock Text=" · Press Ctrl+R to hide" FontSize="11" Foreground="#B45309"
                                                   VerticalAlignment="Center" Margin="4,0,0,0" />
                                    </StackPanel>
                                    <Button x:Name="SensitiveHideButton" DockPanel.Dock="Right" Content="Hide (Ctrl+R)"
                                            Style="{StaticResource HeaderActionButton}" Background="#FED7AA" Foreground="#78350F" />
                                </DockPanel>
                            </Border>

                            <RichTextBox x:Name="PreviewCode" Grid.Row="1" IsReadOnly="True" IsDocumentEnabled="True"
                                         BorderThickness="0" Background="Transparent"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="14,12"
                                         FontFamily="Cascadia Mono, Consolas" FontSize="13" IsReadOnlyCaretVisible="True">
                            </RichTextBox>
                        </Grid>

                        <!-- Plain Text Viewer -->
                        <Grid x:Name="TextContainer" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border x:Name="SensitiveRevealedTextBanner" Grid.Row="0" Background="#FEF3C7" BorderBrush="#FDE68A"
                                    BorderThickness="0,0,0,1" Padding="14,6" Visibility="Collapsed">
                                <DockPanel LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE785;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12.5"
                                                   Foreground="#D97706" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="Sensitive content revealed" FontWeight="SemiBold" FontSize="11.5"
                                                   Foreground="#92400E" VerticalAlignment="Center" />
                                        <TextBlock Text=" · Press Ctrl+R to hide" FontSize="11" Foreground="#B45309"
                                                   VerticalAlignment="Center" Margin="4,0,0,0" />
                                    </StackPanel>
                                    <Button x:Name="SensitiveHideTextButton" DockPanel.Dock="Right" Content="Hide (Ctrl+R)"
                                            Style="{StaticResource HeaderActionButton}" Background="#FED7AA" Foreground="#78350F" />
                                </DockPanel>
                            </Border>

                            <TextBox x:Name="PreviewText" Grid.Row="1" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="14,14"
                                     FontFamily="Cascadia Mono, Consolas" FontSize="13" IsReadOnlyCaretVisible="True">
                                <TextBox.ContextMenu>
                                    <ContextMenu x:Name="PreviewContextMenu" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12.5">
                                        <MenuItem x:Name="MenuPasteSelection" Header="Paste selection" InputGestureText="Enter" FontWeight="SemiBold" />
                                        <MenuItem x:Name="MenuCopySelection" Header="Copy" InputGestureText="Ctrl+C" />
                                        <MenuItem x:Name="MenuCopyAll" Header="Copy all" />
                                        <Separator />
                                        <MenuItem x:Name="MenuSelectAll" Header="Select all" InputGestureText="Ctrl+A" />
                                    </ContextMenu>
                                </TextBox.ContextMenu>
                            </TextBox>
                        </Grid>
                    </Grid>

                    <!-- Row 2: Bottom Metadata Table -->
                    <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="20" />
                                <RowDefinition Height="20" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Source" Style="{StaticResource MetaLabel}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="MetaSource" Style="{StaticResource MetaValue}" />
                            <TextBlock Grid.Row="1" Text="Copied" Style="{StaticResource MetaLabel}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="MetaCopied" Style="{StaticResource MetaValue}" />
                            <TextBlock Grid.Row="2" x:Name="MetaExpiresLabel" Text="Expires" Style="{StaticResource MetaLabel}" Visibility="Collapsed" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="MetaExpires" Style="{StaticResource MetaValue}" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Row 3: Contextual Footer Toolbar (Item 9 & 10) -->
            <Border x:Name="Footer" Grid.Row="3" Background="Transparent" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                <DockPanel Margin="14,0,4,0">
                    <ResizeGrip x:Name="ResizeGripIndicator" DockPanel.Dock="Right" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                Margin="0,0,1,1" IsTabStop="False" Opacity="0.4" ToolTip="Drag to resize" />
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock x:Name="StatusText" Foreground="#64748B" FontSize="11.5" VerticalAlignment="Center" />
                        <Rectangle Width="1" Height="12" Fill="{StaticResource Line}" Margin="14,0,0,0" VerticalAlignment="Center" Opacity="0.8" />
                    </StackPanel>

                    <!-- Context Toolbars on Right -->
                    <Grid VerticalAlignment="Center" HorizontalAlignment="Right">
                        <!-- Normal Context Toolbar -->
                        <StackPanel x:Name="NormalToolbar" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Style="{StaticResource Keycap}"><TextBlock Text="Enter" Style="{StaticResource KeycapText}" /></Border>
                            <TextBlock Text="Paste" Style="{StaticResource HintLabel}" />
                            <Border Style="{StaticResource Keycap}"><TextBlock Text="⇧Enter" Style="{StaticResource KeycapText}" /></Border>
                            <TextBlock Text="Plain" Style="{StaticResource HintLabel}" />
                            <Border Style="{StaticResource Keycap}"><TextBlock Text="Ctrl+P" Style="{StaticResource KeycapText}" /></Border>
                            <TextBlock Text="Pin" Style="{StaticResource HintLabel}" />
                            <Border Style="{StaticResource Keycap}"><TextBlock Text="Ctrl+Space" Style="{StaticResource KeycapText}" /></Border>
                            <TextBlock Text="Select" Style="{StaticResource HintLabel}" />
                            <Border Style="{StaticResource Keycap}"><TextBlock Text="F2" Style="{StaticResource KeycapText}" /></Border>
                            <TextBlock Text="Rename" Style="{StaticResource HintLabel}" />
                            <Border Style="{StaticResource Keycap}"><TextBlock Text="F1" Style="{StaticResource KeycapText}" /></Border>
                            <TextBlock Text="Shortcuts" Style="{StaticResource HintLabel}" />
                        </StackPanel>

                        <!-- Multi-select Context Toolbar (Item 7 & 9) -->
                        <StackPanel x:Name="MultiSelectToolbar" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock x:Name="MultiSelectCountBadge" Text="3 selected" FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Border Style="{StaticResource Keycap}"><TextBlock Text="Enter" Style="{StaticResource KeycapText}" /></Border>
                            <TextBlock Text="Merge &amp; Paste" Style="{StaticResource HintLabel}" />
                            <Border Style="{StaticResource Keycap}"><TextBlock Text="Ctrl+S" Style="{StaticResource KeycapText}" /></Border>
                            <TextBlock Text="Paste Stack" Style="{StaticResource HintLabel}" />
                            <Border Style="{StaticResource Keycap}"><TextBlock Text="Ctrl+P" Style="{StaticResource KeycapText}" /></Border>
                            <TextBlock Text="Pin" Style="{StaticResource HintLabel}" />
                            <Border Style="{StaticResource Keycap}"><TextBlock Text="Del" Style="{StaticResource KeycapText}" /></Border>
                            <TextBlock Text="Delete" Style="{StaticResource HintLabel}" />
                            <Border Style="{StaticResource Keycap}"><TextBlock Text="Esc" Style="{StaticResource KeycapText}" /></Border>
                            <TextBlock Text="Cancel" Style="{StaticResource HintLabel}" />
                        </StackPanel>

                        <!-- Sensitive Context Toolbar (Item 9) -->
                        <StackPanel x:Name="SensitiveToolbar" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="🔒 Sensitive" FontWeight="SemiBold" Foreground="#D97706" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Border Style="{StaticResource Keycap}"><TextBlock Text="Ctrl+R" Style="{StaticResource KeycapText}" /></Border>
                            <TextBlock Text="Reveal" Style="{StaticResource HintLabel}" />
                            <Border Style="{StaticResource Keycap}"><TextBlock Text="Enter" Style="{StaticResource KeycapText}" /></Border>
                            <TextBlock Text="Paste" Style="{StaticResource HintLabel}" />
                            <Border Style="{StaticResource Keycap}"><TextBlock Text="Esc" Style="{StaticResource KeycapText}" /></Border>
                            <TextBlock Text="Close" Style="{StaticResource HintLabel}" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- F1 Help Overlay Modal (Item 11) -->
            <Border x:Name="HelpOverlay" Grid.Row="0" Grid.RowSpan="4" Background="#FFFFFF" CornerRadius="0"
                    BorderThickness="0" Visibility="Collapsed" Panel.ZIndex="100">
                <Grid Margin="22,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <Button x:Name="HelpCloseButton" DockPanel.Dock="Right" Focusable="False"
                                Width="28" Height="28" Cursor="Hand" ToolTip="Close shortcuts help (Esc)"
                                AutomationProperties.Name="Close shortcuts">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                        <TextBlock x:Name="Glyph" Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#14000000" />
                                            <Setter TargetName="Glyph" Property="Foreground" Value="#0F172A" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" Background="#120E6B68" CornerRadius="6" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="&#xE765;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Keyboard Shortcuts" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Border Style="{StaticResource ModalKeycap}" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock Text="F1" Style="{StaticResource ModalKeycapText}" FontSize="10.5" Foreground="{StaticResource Muted}" />
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <!-- Search Input for Shortcuts -->
                    <Border Grid.Row="1" CornerRadius="8" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" Height="36" Margin="0,0,0,12" Padding="12,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="13" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="HelpSearchPlaceholder" Text="Search shortcuts or commands…"
                                           Foreground="#94A3B8" FontSize="12.5" VerticalAlignment="Center" IsHitTestVisible="False" />
                                <TextBox x:Name="HelpSearchBox" BorderThickness="0" Background="Transparent"
                                         FontSize="12.5" VerticalAlignment="Center" VerticalContentAlignment="Center" Padding="0"
                                         AutomationProperties.Name="Search keyboard shortcuts" />
                            </Grid>
                            <Button x:Name="HelpClearSearchButton" Grid.Column="2" Width="18" Height="18" Margin="4,0,0,0"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Focusable="False"
                                    VerticalAlignment="Center" Visibility="Collapsed" ToolTip="Clear search text">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="#14000000" CornerRadius="9" Width="18" Height="18">
                                            <TextBlock Text="✕" FontSize="8.5" FontWeight="Bold"
                                                       Foreground="#5A6170" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#25000000" />
                                                <Setter Property="Foreground" Value="#15171C" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Scrollable Shortcuts Categorized List -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="HelpCategoriesPanel" Margin="0,0,6,0">
                            <!-- NAVIGATION -->
                            <Border Style="{StaticResource ShortcutCard}">
                                <StackPanel>
                                    <DockPanel Margin="4,0,4,8">
                                        <TextBlock Text="&#xE895;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="NAVIGATION" FontSize="11" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <Border Style="{StaticResource ShortcutRow}">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Style="{StaticResource ModalKeycap}"><TextBlock Text="↑" Style="{StaticResource ModalKeycapText}" /></Border>
                                                <Border Style="{StaticResource ModalKeycap}"><TextBlock Text="↓" Style="{StaticResource ModalKeycapText}" /></Border>
                                            </StackPanel>
                                            <TextBlock Text="Navigate items" FontSize="12.5" Foreground="#1E293B" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource ShortcutRow}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Style="{StaticResource ModalKeycap}"><TextBlock Text="Enter" Style="{StaticResource ModalKeycapText}" /></Border>
                                            <TextBlock Text="Paste selected item" FontSize="12.5" Foreground="#1E293B" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource ShortcutRow}">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Style="{StaticResource ModalKeycap}"><TextBlock Text="Ctrl" Style="{StaticResource ModalKeycapText}" /></Border>
                                                <TextBlock Style="{StaticResource KeycapPlus}" />
                                                <Border Style="{StaticResource ModalKeycap}"><TextBlock Text="Shift" Style="{StaticResource ModalKeycapText}" /></Border>
                                                <TextBlock Style="{StaticResource KeycapPlus}" />
                                                <Border Style="{StaticResource ModalKeycap}"><TextBlock Text="Enter" Style="{StaticResource ModalKeycapText}" /></Border>
                                            </StackPanel>
                                            <TextBlock Text="Paste as plain text (or image OCR)" FontSize="12.5" Foreground="#1E293B" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource ShortcutRow}">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Style="{StaticResource ModalKeycap}"><TextBlock Text="Ctrl" Style="{StaticResource ModalKeycapText}" /></Border>
                                                <TextBlock Style="{StaticResource KeycapPlus}" />
                                                <Border Style="{StaticResource ModalKeycap}"><TextBlock Text="1 … 9" Style="{StaticResource ModalKeycapText}" /></Border>
                                            </StackPanel>
                                            <TextBlock Text="Quick paste top row 1 … 9" FontSize="12.5" Foreground="#1E293B" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource ShortcutRow}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Style="{StaticResource ModalKeycap}"><TextBlock Text="Esc" Style="{StaticResource ModalKeycapText}" /></Border>
                                            <TextBlock Text="Close palette / Cancel selection" FontSize="12.5" Foreground="#1E293B" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- CLIPBOARD & ACTIONS -->
                            <Border Style="{StaticResource ShortcutCard}">
                                <StackPanel>
                                    <DockPanel Margin="4,0,4,8">
                                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="CLIPBOARD &amp; ACTIONS" FontSize="11" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" />
