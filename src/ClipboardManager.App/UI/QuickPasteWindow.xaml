<Window x:Class="ClipboardManager.App.UI.QuickPasteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Paste"
        Width="760" Height="520"
        WindowStyle="None" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="True"
        WindowStartupLocation="Manual"
        Background="#FFFFFF" BorderBrush="#CDD1D8" BorderThickness="1"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="#15171C"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#0E6B68" />
        <SolidColorBrush x:Key="Line" Color="#E6E8EC" />
        <SolidColorBrush x:Key="Muted" Color="#5A6170" />

        <Style x:Key="ItemStyle" TargetType="ListBoxItem">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,0,1" />
            <Setter Property="Foreground" Value="#15171C" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F3F5" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MetaLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style x:Key="MetaValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="Kbd" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#DADDE2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="Margin" Value="6,0,14,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Slim overlay-style scrollbar: no arrows, rounded thumb that darkens on hover/drag -->
        <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd" Background="#C4C8CF" CornerRadius="3" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#9AA0AA" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#7D8490" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Margin" Value="0,4,3,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" MinHeight="24" />
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="6" />
                    <Setter Property="MinHeight" Value="6" />
                    <Setter Property="Margin" Value="4,0,4,3" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}" MinWidth="24" />
                                    </Track.Thumb>
                                </Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <!-- Search -->
        <Border x:Name="Header" Grid.Row="0" Background="Transparent" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                ToolTip="Drag to move">
            <DockPanel Margin="18,0">
                <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="16" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <ToggleButton x:Name="KeepOpenButton" DockPanel.Dock="Right" Width="32" Height="32" Margin="8,0,0,0"
                              Focusable="False" Cursor="Hand" ToolTip="Keep open (Ctrl+T)"
                              AutomationProperties.Name="Keep Quick Paste open">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                <TextBlock x:Name="Glyph" Text="&#xE718;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#F1F3F5" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}" />
                                    <Setter TargetName="Glyph" Property="Foreground" Value="#FFFFFF" />
                                    <Setter TargetName="Glyph" Property="Text" Value="&#xE840;" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <TextBlock x:Name="CountText" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="12"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
                <Grid>
                    <TextBlock x:Name="Placeholder" Text="Search clipboard…   type:sql  pinned:true  workspace:name"
                               Foreground="#8A909C" FontSize="15" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent" FontSize="15"
                             VerticalAlignment="Center" VerticalContentAlignment="Center" Padding="0"
                             AutomationProperties.Name="Search clipboard" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- List + preview -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="ItemsList" Grid.Column="0" BorderThickness="0" Padding="6,8"
                     ItemContainerStyle="{StaticResource ItemStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     AutomationProperties.Name="Clipboard items">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding MarkGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding TypeLabel}" FontSize="11.5" Opacity="0.75"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding PinGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" />
                            <TextBlock Text="{Binding Title}" FontFamily="{Binding TitleFont}" FontSize="13"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Rectangle Grid.Column="1" Fill="{StaticResource Line}" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox x:Name="PreviewText" Grid.Row="0" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="14,14"
                         FontFamily="Cascadia Mono, Consolas" FontSize="13" Focusable="False" />
                <Image x:Name="PreviewImage" Grid.Row="0" Stretch="Uniform" Margin="18" Visibility="Collapsed"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock x:Name="EmptyText" Grid.Row="0" Text="Nothing copied yet. Copy something and it will appear here."
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="24" VerticalAlignment="Center"
                           HorizontalAlignment="Center" TextAlignment="Center" Visibility="Collapsed" />

                <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="18,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22" />
                            <RowDefinition Height="22" />
                            <RowDefinition Height="22" />
                            <RowDefinition Height="22" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Type" Style="{StaticResource MetaLabel}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="MetaType" Style="{StaticResource MetaValue}" />
                        <TextBlock Grid.Row="1" Text="Source" Style="{StaticResource MetaLabel}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="MetaSource" Style="{StaticResource MetaValue}" />
                        <TextBlock Grid.Row="2" Text="Copied" Style="{StaticResource MetaLabel}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="MetaCopied" Style="{StaticResource MetaValue}" />
                        <TextBlock Grid.Row="3" Text="Expires" Style="{StaticResource MetaLabel}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="MetaExpires" Style="{StaticResource MetaValue}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border x:Name="Footer" Grid.Row="2" Background="#F8F9FA" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <DockPanel Margin="18,0,4,0">
                <TextBlock x:Name="StatusText" DockPanel.Dock="Left" Foreground="#4A505C" FontSize="12.5" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Paste" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Kbd}"><TextBlock Text="Enter" FontFamily="Cascadia Mono, Consolas" FontSize="11" /></Border>
                    <TextBlock Text="Pin" FontSize="12.5" Foreground="#4A505C" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Kbd}"><TextBlock Text="Ctrl P" FontFamily="Cascadia Mono, Consolas" FontSize="11" /></Border>
                    <TextBlock Text="Select" FontSize="12.5" Foreground="#4A505C" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Kbd}"><TextBlock Text="Ctrl Space" FontFamily="Cascadia Mono, Consolas" FontSize="11" /></Border>
                    <TextBlock Text="Delete" FontSize="12.5" Foreground="#4A505C" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Kbd}"><TextBlock Text="Del" FontFamily="Cascadia Mono, Consolas" FontSize="11" /></Border>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
