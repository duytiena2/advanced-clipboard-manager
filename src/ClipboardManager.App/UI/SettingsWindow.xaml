<Window x:Class="ClipboardManager.App.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clipboard Manager — Settings"
        Width="640" Height="560" MinWidth="520" MinHeight="440"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True" Topmost="True"
        Background="#FFFFFF" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="#15171C"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#0E6B68" />
        <SolidColorBrush x:Key="Muted" Color="#5A6170" />
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,12,0,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E6E8EC" />
            <Setter Property="BorderBrush" Value="#DADDE2" />
            <Setter Property="Background" Value="White" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="CanUserResizeRows" Value="False" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs" Grid.Row="0" Padding="16,8">
            <!-- General -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Quick Paste shortcut" Style="{StaticResource Label}" />
                        <TextBox x:Name="HotkeyBox" Width="220" HorizontalAlignment="Left" IsReadOnly="True" Cursor="Hand"
                                 AutomationProperties.Name="Quick Paste shortcut" />
                        <TextBlock Style="{StaticResource Hint}" Text="Click the box and press the new shortcut, e.g. Ctrl+Shift+V or Win+Alt+V." />

                        <CheckBox x:Name="CaptureBox" Content="Record clipboard history" />

                        <TextBlock Text="Keep at most" Style="{StaticResource Label}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="MaxItemsBox" Width="90" AutomationProperties.Name="Maximum items" />
                            <TextBlock Text="items (pinned items and snippets don't count)" Foreground="{StaticResource Muted}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>

                        <TextBlock Text="Default workspace" Style="{StaticResource Label}" />
                        <TextBox x:Name="DefaultWorkspaceBox" Width="220" HorizontalAlignment="Left" AutomationProperties.Name="Default workspace" />

                        <CheckBox x:Name="OcrBox" Content="Recognize text in copied images (Windows OCR, offline)" />
                        <TextBlock x:Name="OcrHint" Style="{StaticResource Hint}" />

                        <TextBlock Text="Widget &amp; Transparency" Style="{StaticResource Label}" Margin="0,16,0,4" />
                        <CheckBox x:Name="TransparencyBox" Content="Enable iOS-style frosted glass transparency (Trong suốt kiểu iOS)" />
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock Text="Opacity" Style="{StaticResource Hint}" VerticalAlignment="Center" Width="80" />
                            <TextBlock x:Name="OpacityValueText" Text="85%" Foreground="{StaticResource Muted}" FontSize="12" Width="45" TextAlignment="Right" DockPanel.Dock="Right" />
                            <Slider x:Name="OpacitySlider" Minimum="0.50" Maximum="1.0" SmallChange="0.05" LargeChange="0.10" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="8,0" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="Windows 11 Acrylic blur + translucent rounded widget card like modern iOS." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Privacy -->
            <TabItem Header="Privacy">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <CheckBox x:Name="DetectSensitiveBox" Content="Detect secrets (API keys, tokens, passwords) and hide them" />
                        <CheckBox x:Name="NeverPasswordsBox" Content="Never store passwords" />
                        <CheckBox x:Name="NeverKeysBox" Content="Never store private keys" />

                        <TextBlock Text="Don't record copies from these apps" Style="{StaticResource Label}" />
                        <TextBox x:Name="ExcludedBox" Height="96" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="Excluded applications" />
                        <TextBlock Style="{StaticResource Hint}" Text="One app per line (process name, e.g. KeePass). Matches any app whose name contains it." />

                        <CheckBox x:Name="EncryptBox" Content="Encrypt the history with my Windows account (DPAPI)" Margin="0,16,0,0" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Text, formatting and images are encrypted on disk; only your Windows account on this PC can read them, without a password. The search index is kept in memory. Changing this rewrites the whole history (a few seconds)." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Retention -->
            <TabItem Header="Retention">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,8,0,8"
                               Text="How long each kind of item is kept, in minutes. 0 = keep until deleted. Pinned items and snippets never expire." />
                    <DataGrid x:Name="RetentionGrid" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kind" Binding="{Binding Label}" IsReadOnly="True" Width="*" />
                            <DataGridTextColumn Header="Minutes" Binding="{Binding Minutes, UpdateSourceTrigger=PropertyChanged}" Width="110" />
                            <DataGridTextColumn Header="" Binding="{Binding Human}" IsReadOnly="True" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Workspaces -->
            <TabItem Header="Workspaces">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,8,0,8"
                               Text="Copies from an app go to its workspace (exact process name, e.g. Code, OUTLOOK, chrome). First match wins; other copies go to the default workspace. In Quick Paste, Ctrl+W switches workspaces." />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="AddRuleButton" Content="Add rule" Margin="0" />
                        <Button x:Name="RemoveRuleButton" Content="Remove" />
                    </StackPanel>
                    <DataGrid x:Name="RulesGrid" CanUserAddRows="False" CanUserDeleteRows="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="App (process name)" Binding="{Binding App, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTextColumn Header="Workspace" Binding="{Binding Workspace, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Snippets -->
            <TabItem Header="Snippets">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="SnippetHint" Style="{StaticResource Hint}" Margin="0,8,0,8" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="NewSnippetButton" Content="New…" Margin="0" />
                        <Button x:Name="EditSnippetButton" Content="Edit…" />
                        <Button x:Name="DeleteSnippetButton" Content="Delete" />
                    </StackPanel>
                    <DataGrid x:Name="SnippetsGrid" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Title}" Width="180" />
                            <DataGridTextColumn Header="Text" Binding="{Binding Preview}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock x:Name="ErrorText" Foreground="#B42318" TextWrapping="Wrap" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SaveButton" Content="Save" IsDefault="True" Background="{StaticResource Accent}" Foreground="White" BorderThickness="0" />
                <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
