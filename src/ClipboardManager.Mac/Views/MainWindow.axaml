<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClipboardManager.Mac.Views.MainWindow"
        Title="Advanced Clipboard Manager"
        Width="780" Height="500"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur"
        SystemDecorations="None">

    <Border Background="{DynamicResource SystemAltHighColor}"
            BorderBrush="{DynamicResource SystemAccentColor}"
            BorderThickness="1"
            CornerRadius="12"
            BoxShadow="0 10 30 0 #40000000"
            Margin="10">
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- Search bar -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="0,0,0,1" Padding="14,10">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0" Text="&#x26B2;" VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0.5" FontSize="14"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1"
                             Watermark="Search clipboard history, snippets, or type:code …"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="15"
                             VerticalAlignment="Center"/>
                    <TextBlock x:Name="ItemCountText" Grid.Column="2" Text="0 items" VerticalAlignment="Center" FontSize="12" Opacity="0.5"/>
                </Grid>
            </Border>

            <!-- Main content: List + Preview -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,1.2*">
                <!-- Items list -->
                <ListBox x:Name="ItemsList" Grid.Column="0"
                         SelectionMode="Multiple"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid RowDefinitions="Auto,Auto" Margin="4,3">
                                <!-- Row 0: Primary Title, Type Badge -->
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                                    <Border Grid.Column="1" Background="{DynamicResource SystemAccentColorLight2}" CornerRadius="4" Padding="5,1,5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TypeBadge}" FontSize="10.5" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                                <!-- Row 1: Metadata (TimeAgo) on left, States & CopyCount on right -->
                                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,2,0,0">
                                    <TextBlock Grid.Column="0" Text="{Binding TimeAgo}" FontSize="11" Opacity="0.5" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CopyCountText}" FontSize="10" FontWeight="SemiBold" Opacity="0.7"/>
                                        <TextBlock Text="{Binding PinGlyph}" FontSize="11" IsVisible="{Binding IsPinned}"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Draggable Splitter -->
                <GridSplitter Grid.Column="1" Width="5" Background="Transparent" ResizeDirection="Columns" />

                <!-- Preview pane -->
                <ScrollViewer Grid.Column="2" Padding="14">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="PreviewTitle" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                        <SelectableTextBlock x:Name="PreviewContent" TextWrapping="Wrap"
                                             Background="Transparent" FontSize="12" FontFamily="Menlo, Monaco, Consolas, monospace"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Footer: Shortcut hints -->
            <Border Grid.Row="2" Background="{DynamicResource SystemChromeLowColor}" CornerRadius="0,0,11,11" Padding="14,8">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14">
                        <TextBlock Text="↵ Paste (Merge if multi-select)" FontSize="11" Opacity="0.7"/>
                        <TextBlock Text="⇧↵ Plain Text" FontSize="11" Opacity="0.7"/>
                        <TextBlock Text="⌘1-9 Quick" FontSize="11" Opacity="0.7"/>
                        <TextBlock Text="⌘K Transforms" FontSize="11" Opacity="0.7"/>
                        <TextBlock Text="⌘S Stack" FontSize="11" Opacity="0.7"/>
                        <TextBlock Text="⌘P Pin" FontSize="11" Opacity="0.7"/>
                        <TextBlock Text="⎋ Close" FontSize="11" Opacity="0.7"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="Advanced Clipboard Manager" FontSize="11" Opacity="0.4"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
